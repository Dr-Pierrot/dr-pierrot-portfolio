# Environment Configuration
# Copy this file to .env.local and fill in your values

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Dr. Pierrot Portfolio"
NEXT_PUBLIC_SITE_DESCRIPTION="Full-stack developer and creative technologist"

# Contact Form (Resend)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TO_EMAIL=capulongako16@gmail.com

# Analytics (Google Analytics 4)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XG9JB5Z8SL

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_BLOG=true
NEXT_PUBLIC_ENABLE_RESUME_DOWNLOAD=true

# Development
NODE_ENV=development
